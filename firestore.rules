rules_version = '2';

// Security Rules for the Metrordle minigame family's Firestore-backed
// daily leaderboards. metrordle.com has no build/deploy pipeline for
// Firebase, so there's no automated way to ship these - paste this file's
// contents into the Firebase console under Firestore Database > Rules
// (or, if you set up the Firebase CLI later, `firebase deploy --only
// firestore:rules`).
//
// There's no login system on the site, so these rules can only validate
// the SHAPE and plausibility of a write (right types, a score that's
// actually reachable, one document per alias per day) - they cannot
// verify a human genuinely played fair. That's an accepted tradeoff for
// a casual daily leaderboard, not an oversight - do not treat this as a
// substitute for real anti-cheat.
//
// Add another `match` block below, following the same pattern, if
// another game gets its own leaderboard collection later.
service cloud.firestore {
  match /databases/{database}/documents {

    // memoria-leaderboard/{dateKey}/entries/{aliasId}. streak (display
    // -only, the 🔥 flag on /admin/ - see getTopLeaderboardScores()'s
    // own comment in shared.js on why it's never part of orderBySpecs)
    // can legitimately be 0 here, unlike the other three - Memoria
    // submits on every completed round, win or lose, unlike Metrordle/
    // Laberinto/Metroguessr's win-only submission.
    match /memoria-leaderboard/{dateKey}/entries/{aliasId} {
      allow read: if true;

      allow create, update: if
        request.resource.data.keys().hasOnly(['alias', 'score', 'streak', 'submittedAt']) &&
        request.resource.data.alias is string &&
        request.resource.data.alias.size() > 0 &&
        request.resource.data.alias.size() <= 20 &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 200 && // the whole network is 163 stations
        request.resource.data.streak is int &&
        request.resource.data.streak >= 0 &&
        request.resource.data.streak <= 5000 &&
        request.resource.data.submittedAt == request.time &&
        aliasId == request.resource.data.alias.lower();

      allow delete: if false;
    }

    // laberinto-leaderboard/{dateKey}/entries/{aliasId} - ranked ascending
    // (fewer stations/transfers is better), unlike Memoria's descending
    // score, but the same shape/plausibility validation otherwise. Bounds
    // are generous rather than tight since a player can wander the network
    // indefinitely before reaching the destination - there's no move limit
    // to derive a tighter cap from. streak is display-only (see Memoria's
    // own comment above) - only a win submits here, so unlike Memoria's
    // it's always at least 1.
    match /laberinto-leaderboard/{dateKey}/entries/{aliasId} {
      allow read: if true;

      allow create, update: if
        request.resource.data.keys().hasOnly(['alias', 'stations', 'transfers', 'streak', 'submittedAt']) &&
        request.resource.data.alias is string &&
        request.resource.data.alias.size() > 0 &&
        request.resource.data.alias.size() <= 20 &&
        request.resource.data.stations is int &&
        request.resource.data.stations >= 0 &&
        request.resource.data.stations <= 500 &&
        request.resource.data.transfers is int &&
        request.resource.data.transfers >= 0 &&
        request.resource.data.transfers <= 100 &&
        request.resource.data.streak is int &&
        request.resource.data.streak >= 1 &&
        request.resource.data.streak <= 5000 &&
        request.resource.data.submittedAt == request.time &&
        aliasId == request.resource.data.alias.lower();

      allow delete: if false;
    }

    // metrordle-leaderboard/{dateKey}/entries/{aliasId} - one combined
    // leaderboard (not split by normal/hard mode). Ranked by fewest
    // attempts, with a loss always sorting after every win and a
    // hard-mode entry beating a normal-mode entry at the same attempts
    // count (see renderLeaderboard()'s orderBySpecs) - the hardMode/lost
    // fields just need to be plausible bools here, the ordering itself
    // lives client-side. attempts is bounded by TOTAL_ATTEMPTS (1-5 -
    // a loss's attempts is always exactly 5, the same as the hardest
    // possible win). Both a win and a loss submit here now, so streak
    // (display-only, see Memoria's own comment above) can legitimately
    // be 0 - a loss always resets it.
    match /metrordle-leaderboard/{dateKey}/entries/{aliasId} {
      allow read: if true;

      allow create, update: if
        request.resource.data.keys().hasOnly(['alias', 'attempts', 'hardMode', 'lost', 'streak', 'submittedAt']) &&
        request.resource.data.alias is string &&
        request.resource.data.alias.size() > 0 &&
        request.resource.data.alias.size() <= 20 &&
        request.resource.data.attempts is int &&
        request.resource.data.attempts >= 1 &&
        request.resource.data.attempts <= 5 &&
        request.resource.data.hardMode is bool &&
        request.resource.data.lost is bool &&
        request.resource.data.streak is int &&
        request.resource.data.streak >= 0 &&
        request.resource.data.streak <= 5000 &&
        request.resource.data.submittedAt == request.time &&
        aliasId == request.resource.data.alias.lower();

      allow delete: if false;
    }

    // metroguessr-leaderboard/{dateKey}/entries/{aliasId} - ranked by
    // fewest attempts, with a loss always sorting after every win and a
    // hard-mode entry beating a normal-mode entry at the same attempts
    // count, same convention as Metrordle's own combined leaderboard
    // (see renderLeaderboard()'s orderBySpecs) - the hardMode/lost
    // fields just need to be plausible bools here, the ordering itself
    // lives client-side. Bounded 1-5, same as Metrordle's own attempts
    // (MAX_ATTEMPTS in metroguessr/index.html is 5, and a loss's
    // attempts is always exactly that). hintsUsed (0-2) is display-only.
    // Both a win and a loss submit here now, so streak (display-only,
    // see Memoria's own comment above) can legitimately be 0 - a loss
    // always resets it.
    match /metroguessr-leaderboard/{dateKey}/entries/{aliasId} {
      allow read: if true;

      allow create, update: if
        request.resource.data.keys().hasOnly(['alias', 'attempts', 'hardMode', 'lost', 'hintsUsed', 'streak', 'submittedAt']) &&
        request.resource.data.alias is string &&
        request.resource.data.alias.size() > 0 &&
        request.resource.data.alias.size() <= 20 &&
        request.resource.data.attempts is int &&
        request.resource.data.attempts >= 1 &&
        request.resource.data.attempts <= 5 &&
        request.resource.data.hardMode is bool &&
        request.resource.data.lost is bool &&
        request.resource.data.hintsUsed is int &&
        request.resource.data.hintsUsed >= 0 &&
        request.resource.data.hintsUsed <= 2 &&
        request.resource.data.streak is int &&
        request.resource.data.streak >= 0 &&
        request.resource.data.streak <= 5000 &&
        request.resource.data.submittedAt == request.time &&
        aliasId == request.resource.data.alias.lower();

      allow delete: if false;
    }

    // metrocrush-leaderboard/{dateKey}/entries/{aliasId} - same shape as
    // Memoria's (a single descending score), but the bound is generous
    // rather than tight: score is a cumulative total over a whole
    // 60-second round with cascading multipliers (see resolveStep() in
    // metrocrush/index.html), not capped by a fixed puzzle size like
    // Memoria's "163 stations" ceiling, so there's no similarly tight
    // ceiling to derive from. hardMode just needs to be a plausible bool
    // here (same as Metrordle's own leaderboard) - unlike Metrordle,
    // it's not part of the ranking (see renderLeaderboard()'s
    // orderBySpecs comment), only the 🧠 badge shown next to the score.
    // streak (display-only, see Memoria's own comment above) can
    // legitimately be 0 here, same bound as Memoria's own - Metro Crush
    // has no daily win/loss outcome to extend/reset a streak on, so it
    // extends on any round with a non-zero score instead, resetting to 0
    // on a genuine 0-point round, which still submits.
    match /metrocrush-leaderboard/{dateKey}/entries/{aliasId} {
      allow read: if true;

      allow create, update: if
        request.resource.data.keys().hasOnly(['alias', 'score', 'hardMode', 'streak', 'submittedAt']) &&
        request.resource.data.alias is string &&
        request.resource.data.alias.size() > 0 &&
        request.resource.data.alias.size() <= 20 &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 20000 &&
        request.resource.data.hardMode is bool &&
        request.resource.data.streak is int &&
        request.resource.data.streak >= 0 &&
        request.resource.data.streak <= 5000 &&
        request.resource.data.submittedAt == request.time &&
        aliasId == request.resource.data.alias.lower();

      allow delete: if false;
    }

    // records/{gameKey} - one document per game tracking its own
    // highest score ever (MetroShared.updateHighScoreRecord() in
    // shared.js), for Memoria and Metro Crush only: the two games whose
    // leaderboards rank by a raw score rather than a fixed day's puzzle
    // outcome, so "highest ever" is a meaningful cross-day record to
    // chase. Unlike the per-day leaderboard collections above (a fresh
    // document every day, one per player), this is a single long-lived
    // document per game that only a genuinely higher score is ever
    // allowed to overwrite - request.resource.data.score >
    // resource.data.score on update is what makes that a server-
    // enforced guarantee rather than something only well-behaved client
    // code happens to respect: even a malicious direct write can only
    // ever raise the record, never lower or "reset" it. The bound
    // matches each game's own leaderboard bound above (tight for
    // Memoria's fixed 163-station board, generous for Metro Crush's
    // open-ended cascading score). gameNumber (each game's own #N,
    // MetroShared.getGameNumberForDateKey(dateKey, START_DATE_KEY)) is
    // stored alongside dateKey rather than only derived at display time
    // - unlike every other #N shown in this app (always computed fresh
    // from a live dateKey), this one describes a fact about a fixed
    // moment in the past, so it's stored the same way dateKey itself
    // is: a plain fact about the record, not a value that should ever
    // change if this collection gets a new reader later that doesn't
    // already carry each game's own START_DATE_KEY around like
    // /admin/'s own GAMES array does today.
    match /records/{gameKey} {
      allow read: if true;

      allow create: if
        gameKey in ['memoria', 'metrocrush'] &&
        request.resource.data.keys().hasOnly(['score', 'alias', 'dateKey', 'gameNumber', 'submittedAt']) &&
        request.resource.data.alias is string &&
        request.resource.data.alias.size() > 0 &&
        request.resource.data.alias.size() <= 20 &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= (gameKey == 'memoria' ? 200 : 20000) &&
        request.resource.data.dateKey is string &&
        request.resource.data.gameNumber is int &&
        request.resource.data.gameNumber >= 1 &&
        request.resource.data.submittedAt == request.time;

      allow update: if
        gameKey in ['memoria', 'metrocrush'] &&
        request.resource.data.keys().hasOnly(['score', 'alias', 'dateKey', 'gameNumber', 'submittedAt']) &&
        request.resource.data.alias is string &&
        request.resource.data.alias.size() > 0 &&
        request.resource.data.alias.size() <= 20 &&
        request.resource.data.score is int &&
        request.resource.data.score > resource.data.score &&
        request.resource.data.score <= (gameKey == 'memoria' ? 200 : 20000) &&
        request.resource.data.dateKey is string &&
        request.resource.data.gameNumber is int &&
        request.resource.data.gameNumber >= 1 &&
        request.resource.data.submittedAt == request.time;

      allow delete: if false;
    }
  }
}
